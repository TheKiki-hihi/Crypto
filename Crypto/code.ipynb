    "def compter_occurences(caractère,chaine):\n",
    "    x=0\n",
    "    for i in range (len(chaine)):\n",
    "        if chaine[i]==caractère:\n",
    "            x+=1\n",
    "    return x \n",
    "\n",
    "compter_occurences(\"k\",\"kilpéric\")"
   ]
